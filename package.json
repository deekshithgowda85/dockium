{
  "name": "dockium",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "dockium": "./bin/dockium.js"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "start": "electron .",
    "build:renderer": "vite build",
    "build": "npm run build:renderer",
    "preview": "vite preview",
    "pack": "npm run build:renderer && electron-builder --dir",
    "dist": "npm run build:renderer && electron-builder --win nsis",
    "dist:win": "npm run build:renderer && electron-builder --win nsis",
    "dist:all": "npm run build:renderer && electron-builder -mwl",
    "dockium": "node ./bin/dockium.js"
  },
  "dependencies": {
    "@faker-js/faker": "^9.8.0",
    "axios": "^1.13.1",
    "bcrypt": "^5.1.1",
    "commander": "^14.0.1",
    "dockerode": "^4.0.9",
    "electron-store": "^10.1.0",
    "glob": "^11.0.3",
    "http-mitm-proxy": "^0.8.1",
    "node-fetch": "^3.3.2",
    "pdfkit": "^0.17.2",
    "pg": "^8.13.1",
    "playwright": "^1.55.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "simple-git": "^3.28.0",
    "mysql2": "^3.11.5",
    "ws": "^8.18.3",
    "winston": "^3.18.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.10",
    "wait-on": "^8.0.5"
  }
}